{
  "name": "dealertech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node -e \"console.error('db:push would DROP every RLS policy in this database — see src/db/README.md. Use npm run db:apply.'); process.exit(1)\"",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/db/seed/index.ts",
    "cadence:run": "tsx --env-file=.env.local scripts/run-cadence.ts",
    "pricing:sync": "tsx --conditions=react-server --env-file=.env.local scripts/run-pricing-sync.ts",
    "check:env": "tsx --env-file=.env.local scripts/check-env.ts",
    "check:db": "tsx --env-file=.env.local scripts/check-db.ts",
    "verify:rls": "tsx --env-file=.env.local scripts/verify-rls.ts",
    "smoke": "tsx --env-file=.env.local scripts/smoke.ts",
    "db:test:up": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 up",
    "db:test:reset": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 reset",
    "db:test:down": "powershell -ExecutionPolicy Bypass -File scripts/test-db.ps1 down",
    "auth:provision": "tsx --env-file=.env.local scripts/provision-auth-users.ts",
    "db:apply": "tsx --env-file=.env.local scripts/apply-migrations.ts",
    "storage:provision": "tsx --env-file=.env.local scripts/provision-storage.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
