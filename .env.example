# ===========================================================================
# DealerTech.io — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never put a real secret in here.
# ===========================================================================


# ---------------------------------------------------------------------------
# DATABASE
#
# Local development uses a throwaway Postgres container:
#   npm run db:test:up && npm run db:seed
#
# Against Supabase, use the SESSION pooler on port 5432 (Connect → Direct →
# Session pooler). NOT the transaction pooler on 6543 — it lacks the session
# features drizzle-kit migrations need. Percent-encode special characters in
# the password (@ -> %40, # -> %23).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:dealertech@localhost:54329/dealertech_test


# ---------------------------------------------------------------------------
# SUPABASE — Settings → API Keys ("Publishable and secret" tab)
#
# Use a Supabase project dedicated to DealerTech. Dealership customer PII
# falls under the FTC Safeguards Rule; co-locating it with an unrelated
# product widens both the blast radius and the audit scope for no benefit.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (sb_publishable_...). Safe in the browser ONLY because
# row-level security is enforced on every tenant-scoped table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). SERVER ONLY — bypasses row-level security
# entirely. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------------------------
# AUTH
#
# Sign-in uses Supabase Auth against the project above. Give the seeded staff
# accounts a login with:
#
#   npm run auth:provision
#
# It creates one auth user per row in `users`, reusing the SAME uuid — every
# RLS policy resolves a tenant through user_store_roles.user_id = auth.uid(),
# so a mismatched id would sign someone in to an empty dealership.
#
# The shared password for the seeded demo staff.
#
# DEMO_PASSWORD is read by the provisioning script when it CREATES accounts.
# It refuses this committed value against any non-local database, because a
# password in the repository is a public one — set a real one there:
#
#   DEMO_PASSWORD="$(openssl rand -base64 24)" npm run auth:provision
#
# To change it on accounts that already exist, rotate rather than reprovision.
# `auth:provision --repair` does NOT touch passwords; it only relinks an auth
# id that has drifted from its application row.
#
#   npm run demo:rotate
#
# NEXT_PUBLIC_DEMO_PASSWORD is the same value, and only makes the one-tap demo
# cards on the sign-in page fill the password field. Optional, development
# only, and never set on a deployed site.
# ---------------------------------------------------------------------------
DEMO_PASSWORD=dealertech-demo
NEXT_PUBLIC_DEMO_PASSWORD=

# The gated demo tour at /tour signs a prospect into one of the seeded demo
# staff accounts, so it needs their shared password — the SAME value that
# `npm run demo:rotate` last printed.
#
# SERVER ONLY. Never prefix with NEXT_PUBLIC_, and never reuse
# NEXT_PUBLIC_DEMO_PASSWORD above: that one is compiled into the browser bundle
# by definition, so setting it on a deployed site publishes the demo credential
# to every visitor.
#
# Unset, /tour refuses rather than falling back to DEMO_PASSWORD's committed
# value — the same discipline as the cron secret and the Stripe webhook. If
# tours suddenly stop working, the usual cause is a `demo:rotate` that did not
# come with an update here.
#
# This is the ONLY environment variable the tour needs. The codes themselves
# are issued from /admin/leads and live in the database.
DEMO_TOUR_PASSWORD=


# ---------------------------------------------------------------------------
# DMS ADAPTER
#
# Which dealer management system to talk to. The application only ever calls
# the DmsAdapter interface, so switching vendors is this one variable plus one
# adapter file — see src/lib/dms/adapter.ts for the how-to.
#
#   mock  (default) reads the seeded demo dealership; pushes go to a log
# ---------------------------------------------------------------------------
DMS_ADAPTER=mock

# Deploying? See DEPLOYING.md. In particular DATABASE_URL must be Supabase's
# transaction pooler (port 6543) on a serverless host, not the direct
# connection that is right for local development.

# Coverage situation the mock should simulate, for developing against the
# cases that matter. Leave unset to use whatever the seed contains.
#
#   AS_SEEDED | NO_COVERAGE | ACTIVE_VSC | EXPIRING_PPM | TIRE_AND_WHEEL | FULL_STACK
DMS_MOCK_SCENARIO=AS_SEEDED


# ---------------------------------------------------------------------------
# AI CO-PILOT — the advisor sidekick on the Drive surface.
#
# Leave COPILOT_PROVIDER unset (or "mock") and the Co-Pilot runs on the
# deterministic demo provider: no key, no cost, answers still grounded in the
# real prep sheet. Set it to "anthropic" AND supply a key to use a real model.
#
# The opt-in is deliberately explicit — a key sitting here for some other
# purpose should not silently start billing for every tap on the drive.
# ---------------------------------------------------------------------------
COPILOT_PROVIDER=mock


# ---------------------------------------------------------------------------
# ANTHROPIC — Co-Pilot (above) and contract PDF extraction (Phase 2).
# Not required to run the app. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------------
# STRIPE — subscription billing.
#
# DealerTech bills from its OWN Stripe account (acct_1U57SyKD1OmZb0LX),
# separate from any other business under the same login. That separation is
# why the webhook endpoint only ever receives our events and why a dealership's
# card statement says DEALERTECH.
#
# Leave both unset and billing is simply off: the app runs, tenants keep their
# lifecycle status, and every Stripe path refuses rather than falling back.
# That is deliberate — a billing integration that quietly does nothing when
# misconfigured looks exactly like "nobody has paid yet".
#
# USE A RESTRICTED KEY (rk_...), NOT THE SECRET KEY (sk_...).
# Grant it write on: Customers, Subscriptions, Checkout Sessions, Billing
# Portal, and read on Prices and Products. Nothing here needs to issue a
# refund or read a balance, and a key that cannot do a thing cannot be tricked
# into doing it. Create one at:
#   https://dashboard.stripe.com/acct_1U57SyKD1OmZb0LX/apikeys
#
# SERVER ONLY — never prefix either of these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# From the webhook endpoint you create pointing at /api/webhooks/stripe.
# Subscribe it to: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed, invoice.marked_uncollectible.
#
# Unset means the endpoint refuses every delivery rather than accepting
# unverified JSON — which anybody could otherwise use to mark their own
# dealership as paid.
STRIPE_WEBHOOK_SECRET=
