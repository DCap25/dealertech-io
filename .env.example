# ===========================================================================
# DealerTech.io — environment template
#
# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Never put a real secret in here.
# ===========================================================================


# ---------------------------------------------------------------------------
# DATABASE
#
# Local development uses a throwaway Postgres container:
#   npm run db:test:up && npm run db:seed
#
# Against Supabase, use the SESSION pooler on port 5432 (Connect → Direct →
# Session pooler). NOT the transaction pooler on 6543 — it lacks the session
# features drizzle-kit migrations need. Percent-encode special characters in
# the password (@ -> %40, # -> %23).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:dealertech@localhost:54329/dealertech_test


# ---------------------------------------------------------------------------
# SUPABASE — Settings → API Keys ("Publishable and secret" tab)
#
# Use a Supabase project dedicated to DealerTech. Dealership customer PII
# falls under the FTC Safeguards Rule; co-locating it with an unrelated
# product widens both the blast radius and the audit scope for no benefit.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key (sb_publishable_...). Safe in the browser ONLY because
# row-level security is enforced on every tenant-scoped table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). SERVER ONLY — bypasses row-level security
# entirely. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=


# ---------------------------------------------------------------------------
# AUTH
#
# Sign-in uses Supabase Auth against the project above. Give the seeded staff
# accounts a login with:
#
#   npm run auth:provision
#
# It creates one auth user per row in `users`, reusing the SAME uuid — every
# RLS policy resolves a tenant through user_store_roles.user_id = auth.uid(),
# so a mismatched id would sign someone in to an empty dealership.
#
# Demo password for every seeded account. Development only.
# ---------------------------------------------------------------------------
DEMO_PASSWORD=dealertech-demo


# ---------------------------------------------------------------------------
# DMS ADAPTER
#
# Which dealer management system to talk to. The application only ever calls
# the DmsAdapter interface, so switching vendors is this one variable plus one
# adapter file — see src/lib/dms/adapter.ts for the how-to.
#
#   mock  (default) reads the seeded demo dealership; pushes go to a log
# ---------------------------------------------------------------------------
DMS_ADAPTER=mock

# Deploying? See DEPLOYING.md. In particular DATABASE_URL must be Supabase's
# transaction pooler (port 6543) on a serverless host, not the direct
# connection that is right for local development.

# Coverage situation the mock should simulate, for developing against the
# cases that matter. Leave unset to use whatever the seed contains.
#
#   AS_SEEDED | NO_COVERAGE | ACTIVE_VSC | EXPIRING_PPM | TIRE_AND_WHEEL | FULL_STACK
DMS_MOCK_SCENARIO=AS_SEEDED


# ---------------------------------------------------------------------------
# AI CO-PILOT — the advisor sidekick on the Drive surface.
#
# Leave COPILOT_PROVIDER unset (or "mock") and the Co-Pilot runs on the
# deterministic demo provider: no key, no cost, answers still grounded in the
# real prep sheet. Set it to "anthropic" AND supply a key to use a real model.
#
# The opt-in is deliberately explicit — a key sitting here for some other
# purpose should not silently start billing for every tap on the drive.
# ---------------------------------------------------------------------------
COPILOT_PROVIDER=mock


# ---------------------------------------------------------------------------
# ANTHROPIC — Co-Pilot (above) and contract PDF extraction (Phase 2).
# Not required to run the app. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
